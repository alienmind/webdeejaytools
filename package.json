{
  "name": "webdeejaytools",
  "version": "0.1.0",
  "description": "DJ Automation Suite for playlist conversion, audio downloading, and metadata sync",
  "author": "Alienmind",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:client": "tsc -b && vite build",
    "build:electron": "vite build --config vite.electron.config.ts",
    "build:all": "pnpm run build:client && pnpm run build:electron",
    "dist:win": "pnpm run build:all && electron-builder --win --x64",
    "dist:mac": "pnpm run build:all && electron-builder --mac",
    "dist:linux": "pnpm run build:all && electron-builder --linux",
    "dist:all": "pnpm run build:all && electron-builder -mwl",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.5",
    "lucide-react": "^1.16.0",
    "music-metadata": "^11.1.2",
    "node-id3": "^0.2.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-filename": "^1.6.3"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^0.26.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.62.1",
    "playwright-extra": "^4.3.6",
    "postcss": "^8.4.49",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
